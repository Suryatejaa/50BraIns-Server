{
  "name": "50brains-gig-service",
  "version": "1.0.0",
  "description": "Gig and opportunity management service for 50BraIns platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --env-file=.env.local src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "cron:daily-payouts": "node scripts/daily-payout-cron.js",
    "cron:check-pending": "node -e \"require('./scripts/daily-payout-cron').checkPendingPayouts().then(console.log)\""
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "gig",
    "marketplace",
    "influencer",
    "brand",
    "collaboration"
  ],
  "author": "50BraIns Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.925.0",
    "@aws-sdk/s3-request-presigner": "^3.925.0",
    "@prisma/client": "^6.17.1",
    "amqplib": "^0.10.8",
    "axios": "^1.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.11.0",
    "node-cron": "^4.2.1",
    "razorpay": "^2.9.6",
    "redis": "^4.7.1",
    "uuid": "^9.0.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^6.17.1"
  }
}
